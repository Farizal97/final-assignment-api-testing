      "name": "01 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();\r",
              "\r",
              "// Simpan token otomatis\r",
              "pm.collectionVariables.set(\"token\", jsonData.data.token);\r",
              "\r",
              "// Assertion status code\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Assertion response body\r",
              "pm.test(\"Login successful and token exists\", function () {\r",
              "    pm.expect(jsonData.success).to.eql(true);\r",
              "    pm.expect(jsonData.data.token).to.be.a(\"string\").and.not.empty;\r",
              "});\r",
              "\r",
              "// Assertion response time\r",
              "pm.test(\"Response time is below 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
